<h1 class="title">Steady State Calculator</h1>
<p class="subtitle">Calculate drug steady-state concentration over time</p>

<div class="box">
  <%= form_tag(steady_states_path, method: :get) do %>
    <div class="field">
      <%= label_tag :name, "Drug name", class: "label" %>
      <div class="control">
        <%= text_field_tag :name, params[:name], class: "input", placeholder: "e.g. Dopamine" %>
      </div>
    </div>

    <div class="field">
      <%= label_tag :admin, "Administered dosage (µg/time)", class: "label" %>
      <div class="control">
        <%= text_field_tag :admin, params[:admin], class: "input", placeholder: "e.g. 100" %>
      </div>
    </div>

    <div class="field">
      <%= label_tag :half, "Half-life (time)", class: "label" %>
      <div class="control">
        <%= text_field_tag :half, params[:half], class: "input", placeholder: "e.g. 2" %>
      </div>
    </div>

    <div class="field">
      <%= label_tag :number, "Number of administrations", class: "label" %>
      <div class="control">
        <%= text_field_tag :number, params[:number], class: "input", placeholder: "e.g. 10" %>
      </div>
    </div>

    <div class="field">
      <div class="control">
        <%= submit_tag "Show Steady State", class: "button is-primary" %>
      </div>
    </div>
  <% end %>
</div>

<div class="notification is-info is-light">
  Remember to use the same time value (minutes or days and so on)
</div>
